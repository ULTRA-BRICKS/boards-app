{
  "name": "boards-app",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {"node": ">=22.16.0"},
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:type": "node scripts/type-server.mjs",
    "build": "node scripts/build.mjs",
    "build:type": "node scripts/build.mjs --type",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python3 tests/browser.py",
    "verify": "npm test && npm run build && npm run build:type",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:type": "node scripts/deploy-type.mjs",
    "build:type:neon": "node scripts/build-neon-type.mjs",
    "deploy:type:neon": "node scripts/deploy-neon-type.mjs"
  },
  "dependencies": {"@neondatabase/serverless": "1.0.0"},
  "devDependencies": {"nx": "^21.5.2", "playwright": "^1.55.0"}
}
