{
  "name": "boards-prototype",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build.ts",
    "test": "bun build-icons.ts && bun test tests",
    "lint": "oxlint app.mjs lib api accounts photo tooling tests check-stage.ts boot-guard.js build.ts build-icons.ts serve.ts slack-export.ts --deny-warnings && oxlint -c .oxlint-browser.json app.mjs --deny-warnings",
    "format": "oxfmt --write app.mjs lib tests build.ts",
    "test:browser": "bun tests/ui.ts",
    "test:webkit": "BROWSER=webkit bun tests/ui.ts",
    "format:check": "oxfmt --check app.mjs lib api accounts photo tooling tests check-stage.ts boot-guard.js build.ts build-icons.ts serve.ts slack-export.ts",
    "test:loading": "bun tests/loading-regressions.ts",
    "test:accounts-ui": "bun tests/account-screens.ts",
    "typecheck:accounts": "tsc -p tsconfig.accounts.json",
    "typecheck:photo": "tsc -p tsconfig.photo.json",
    "test:photo-ui": "bun tests/photo-space-browser.ts",
    "typecheck:cache": "tsc -p tsconfig.cache.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tabler/icons": "3.46.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "roughjs": "4.6.6",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "web-vitals": "6.2.1"
  }
}
