{
  "name": "board",
  "root": "apps/board",
  "targets": {
    "dev": { "executor": "nx:run-commands", "options": { "command": "bun run dev" } },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/board"],
      "options": { "command": "bun run build" }
    },
    "test": { "executor": "nx:run-commands", "options": { "command": "bun run test" } },
    "deploy": { "executor": "nx:run-commands", "options": { "command": "bun run deploy" } }
  }
}
