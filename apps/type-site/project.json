{
  "name": "type-site",
  "root": "apps/type-site",
  "targets": {
    "dev": { "executor": "nx:run-commands", "options": { "command": "bun run dev:type" } },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/type-site"],
      "options": { "command": "bun run build:type" }
    },
    "deploy": { "executor": "nx:run-commands", "options": { "command": "bun run deploy:type" } }
  }
}
